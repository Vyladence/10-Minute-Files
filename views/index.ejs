<!DOCTYPE html>
<html>
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <script>document.documentElement.classList.add('no-transitions');</script>
        <style>
            :root {
                --base: #242424;
                --header: #171717;
            }

            html {
                height: 100%;
            }

            body {
                margin: 0;
                background: var(--base);
                display: flex;
                flex-direction: column;
                height: 100%;
            }

            .container {
                flex: 1 1 auto;
            }

            .header {
                flex: 0 1 auto;
            }

            html.no-transitions *, html.no-transitions *::before, html.no-transitions *::after {
                transition: none !important;
                animation-duration: 0s !important;
            }
        </style>
        <link rel="stylesheet" href="/desktop_stylesheets/header.css"></link>
        <link rel="stylesheet" href="/desktop_stylesheets/default-page.css"></link>
        <link rel="stylesheet" href="/mobile_stylesheets/header.css" media="screen and (max-width: 768px)">
        <link rel="stylesheet" href="/desktop_stylesheets/fonts.css"></link>

        <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png">
		<link rel="manifest" href="/favicons/site.webmanifest">
		<link rel="mask-icon" href="/favicons/safari-pinned-tab.svg" color="#5bbad5">
		<link rel="shortcut icon" href="/favicons/favicon.ico">
		<meta name="msapplication-TileColor" content="#da532c">
		<meta name="msapplication-config" content="/favicons/browserconfig.xml">
		<meta name="theme-color" content="#ffffff">

        <meta content="10 Minute Files" property="og:title" />
    	<meta content="Upload a file, get a short link, and share it instantly. Each link lasts for 10 minutes, after which the file is permanently deleted. Share files without leaving anything behind." property="og:description" />
    	<meta content="https://10minutefiles.com" property="og:url" />
    	<meta content="https://10minutefiles.com/static/preview.webp" property="og:image" />
    	<meta name="theme-color" content="#9430c3" data-react-helmet="true" />
		<meta name="twitter:card" content="summary_large_image">
		<meta name="description" content="Upload a file, get a short link, and share it instantly. Each link lasts for 10 minutes, after which the file is permanently deleted. Share files without leaving anything behind." />
    </head>
    <body>
        <div class="header">
            <a class="site-logo" href="/">
                <img class="icon" src="/favicons/android-chrome-192x192.png"> 
                <div class="name">10 Minute Files</div>
            </a>
            <nav class="header-nav">
                <a class="header-link" href="/">Upload</a>
                <a class="header-link" href=/about>About</a>
                <a class="header-link" href=/issues>Feedback</a>
                <a class="header-link" href="/donate">Donate</a>
            </nav>
        </div>
        
        <!-- particles.js container -->
        <div id="tsparticles"></div>
        <script src=https://cdn.jsdelivr.net/npm/tsparticles/dist/tsparticles.min.js></script>
        <script src=/scripts/main.js></script>

        <div class="container" id="page-container">
            <% // Render selectedpage by default, or allow a specific partial path to be specified %> 
            <%- include(data.renderPath || `./partials/${data.selectedPage}/index.ejs`) %>
        </div>
    </body>
</html>
    
<script>
    window.addEventListener('load', function() { document.documentElement.classList.remove('no-transitions'); });
</script>
